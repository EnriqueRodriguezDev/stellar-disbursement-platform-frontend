FROM node:22-alpine AS build

WORKDIR /app
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

COPY . ./
RUN mkdir -p src/generated && echo "export default { commitHash: 'railway', version: '7.0.0' };" > src/generated/gitInfo.ts
RUN yarn build

FROM nginx:1.27-alpine

COPY --from=build /app/build/ /usr/share/nginx/html/
COPY --from=build /app/nginx.conf /etc/nginx/conf.d/default.conf
COPY railway/entrypoint.sh /docker-entrypoint.d/99-railway-init.sh
RUN chmod +x /docker-entrypoint.d/99-railway-init.sh

EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
