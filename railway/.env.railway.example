# ==============================================================================
# Variables de entorno para Frontend SDP en Railway (Stellar Testnet)
# ==============================================================================

# URL pública del backend desplegado en Railway (sdp-api)
API_URL=https://sdp-api-production.up.railway.app

# Modo Single Tenant (desactiva la resolución por subdominio)
SINGLE_TENANT_MODE=true

# Stellar Explorer para Testnet
STELLAR_EXPERT_URL=https://stellar.expert/explorer/testnet

# Servidor Horizon de Stellar Testnet
HORIZON_URL=https://horizon-testnet.stellar.org

# Habilitar integración con Soroban / RPC
RPC_ENABLED=true

# Desactivar Google reCAPTCHA para entorno inicial / dev
RECAPTCHA_SITE_KEY=
